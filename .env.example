# Names/placeholders only. Canonical receiver reads the process environment.
# Do not paste credentials into chats, commits, command lines, or logs.
GITHUB_REPOSITORY=
GITHUB_WEBHOOK_SECRET=
ACCEPTANCE_ENVIRONMENT=SANDBOX
GITHUB_ACCEPTANCE_ENABLED=false
CANONICAL_LIVE_CAPTURE_ENABLED=false
# Work delivery only; receiver does not need a GitHub API token.
GITHUB_TOKEN=
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
# Live credentials remain a separate activation checkpoint.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Authenticated Principal Boundary V1: independently generated high-entropy secrets.
# Supply through protected service environment; receiver/GitHub/payment do not use them.
MARKETPLACE_PRODUCER_SECRET=
MARKETPLACE_VALIDATOR_SECRET=
