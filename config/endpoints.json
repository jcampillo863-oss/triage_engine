{
  "endpoints": [
    {
      "name": "Local Test Mock Feed",
      "type": "local_file",
      "url": "./data/mock_feed.json",
      "enabled": true,
      "payout_types": ["paypal"]
    },
    {
      "name": "GitHub Open Bounties Feed",
      "type": "rest",
      "url": "https://api.github.com/search/issues?q=label:bounty+state:open&sort=created&order=desc",
      "enabled": true,
      "payout_types": ["paypal", "fiat_stripe"]
    },
    {
      "name": "GitHub QA & Testing Feed",
      "type": "rest",
      "url": "https://api.github.com/search/issues?q=label:qa+state:open&sort=created&order=desc",
      "enabled": true,
      "payout_types": ["paypal", "fiat_stripe"]
    }
  ]
}